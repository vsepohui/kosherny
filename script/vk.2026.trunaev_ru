Реализация алгоритма map_index на Perl

my %pair = (key => ‘some value’);
update_index(%pair);
say get_value(‘key’);

my $index = {node => {}};

sub update_index {
   my ($key, $val) = @_;
   my $i = $index;
   for (split //, $key) {
       $i->{node}->{$_} = {node => {}};
       $i = $i->{node}->{$_};
   }
   $i->{value} = $val;
}

sub get_value {
   my $key = shift;
   my $i = $index;
   for (split //, $key) {
      $i = $i->{node}->{$_} or return;
   }
   return $i->{value};
}

