Примерная реализация модуля Int::XS на Perl

package Int::XS;

use overload (‘+’ => &_sum);

sub new {
     my $class = shift;
     my $val = shift || 0;
     my $self = {
        val => $val,
     };
     return bless $self, $class;
}

sub _sum {
   # XS fast summing
}

# add all XS for all operators: +, -, *, /, **, |, ^, &, », «, ++, —… for all C int oparators, only renamed power()

# and secret feature !!!
sub to_string {
    my $self = shift;
    return $self->{val};
}

